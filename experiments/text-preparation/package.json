{
  "name": "@webgpu-text/text-preparation-experiment",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && rolldown src/browser-entry.ts --file dist/browser/browser-entry.js --format esm --platform browser --transform.target es2023 --minify && cp src/browser-smoke.html dist/browser/index.html",
    "benchmark": "tsc -p tsconfig.json && node dist/src/benchmark.js",
    "fixtures:record": "tsc -p tsconfig.json && node dist/src/record-fixtures.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@webgpu-text/font": "workspace:^",
    "@webgpu-text/layout": "workspace:^",
    "bidi-js": "1.0.3",
    "unicode-script": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "rolldown": "1.1.5",
    "vitest": "4.1.10"
  }
}
