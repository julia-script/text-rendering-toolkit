  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/three": "0.185.1",
    "@vitest/browser-playwright": "4.1.10",
    "@webgpu/types": "0.1.71",
    "playwright": "1.61.1",
    "vitest": "4.1.10"
  }
}
