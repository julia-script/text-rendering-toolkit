{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["NPM_REGISTRY", "PUBLISHED_PACKAGES"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "content/docs/api/**", "public/repository/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
