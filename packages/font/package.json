{
  "name": "@text-rendering-toolkit/font",
  "version": "0.3.0",
  "description": "Font parsing, shaping, coverage, and numeric glyph outlines for text rendering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/text-rendering-toolkit.git",
    "directory": "packages/font"
  },
  "homepage": "https://github.com/julia-script/text-rendering-toolkit#readme",
  "bugs": {
    "url": "https://github.com/julia-script/text-rendering-toolkit/issues"
  },
  "keywords": [
    "text-rendering",
    "typography",
    "font",
    "harfbuzz",
    "shaping",
    "unicode",
    "glyphs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module --eval \"import {cpSync} from 'node:fs'; cpSync('src/internal/vendor/harfbuzz.wasm', 'dist/internal/vendor/harfbuzz.wasm')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
