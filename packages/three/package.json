{
  "name": "@text-rendering-toolkit/three-webgpu",
  "version": "0.2.0",
  "description": "Three.js WebGPU text rendering for renderer-neutral Text Rendering Toolkit layouts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/text-rendering-toolkit.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/julia-script/text-rendering-toolkit#readme",
  "bugs": {
    "url": "https://github.com/julia-script/text-rendering-toolkit/issues"
  },
  "keywords": [
    "text-rendering",
    "typography",
    "three.js",
    "webgpu",
    "signed-distance-field",
    "sdf",
    "3d"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "@text-rendering-toolkit/font": "workspace:^"
  },
  "dependencies": {
    "@text-rendering-toolkit/layout": "workspace:^",
    "@text-rendering-toolkit/sdf": "workspace:^"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  }
}
